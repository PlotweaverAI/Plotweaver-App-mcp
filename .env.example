# STORM-OS-TTS-V2 (voice cloning, studio voices). Key is sent only to STORM_BASE_URL.
STORM_API_KEY=your_storm_api_key_here
STORM_BASE_URL=http://18.208.227.247:8000

# STORM TTS v5 (streaming, John, Morenike, Emeka, ...). Key is sent only to STORM_TTS_BASE_URL.
# STORM_TTS_API_KEY=your_storm_tts_api_key_here
# STORM_TTS_BASE_URL=http://54.198.152.226:8000

# Directory the MCP server may read reference audio from and write output to (default: working directory)
# STORM_MCP_ROOT=/Users/you/storm-audio

# STORM-OS ASR (speech-to-text). Turns on the storm_asr_transcribe tool. Key is sent only to STORM_ASR_BASE_URL.
# STORM_ASR_API_KEY=your_storm_asr_api_key_here
# STORM_ASR_BASE_URL=http://34.228.222.150:8000
